{
    "name": "finget/sdk",
    "description": "Official PHP SDK for the Finget passwordless login and notification API",
    "type": "library",
    "license": "MIT",
    "keywords": ["finget", "login", "otp", "passwordless", "notifications", "iran"],
    "homepage": "https://finget.ir",
    "support": {
        "docs": "https://finget.ir/provider/panel/docs",
        "issues": "https://github.com/amirsafaridevs/finget-php/issues",
        "source": "https://github.com/amirsafaridevs/finget-php",
        "chat": "https://finget.ir/contact"
    },
    "authors": [
        {
            "name": "Finget",
            "homepage": "https://finget.ir",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Finget\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
